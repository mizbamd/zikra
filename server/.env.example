# Local Postgres (Homebrew postgresql@14)
DATABASE_URL=jdbc:postgresql://localhost:5432/zikra
DATABASE_USER=samreen
DATABASE_PASSWORD=

# JWT — local default is fine on your laptop only.
# Production: set ZIKRA_ENV=production and a long random secret (≥ 32 chars).
# Tokens expire after 14 days. Rotating JWT_SECRET signs out every device.
JWT_SECRET=zikra-local-dev-change-me-please-32chars
# ZIKRA_ENV=production

# HTTP — bind 0.0.0.0 so Docker / Fly can reach the process.
# Production TLS terminates at Fly or Caddy (HTTPS only on the public URL).
PORT=8080
HOST=0.0.0.0

# Optional CORS allow-list (comma-separated origins). Empty = any origin.
# CORS_ORIGINS=https://zikra.app

# Google Sign-In (stub in v1). When ready, set the Web client ID
# and implement token verification in AuthRoutes.
# GOOGLE_WEB_CLIENT_ID=
